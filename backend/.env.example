# TheContentCompany Backend Environment Variables

# Hugging Face Inference API Token (Required for Qwen-72B, Whisper, BGE-small)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# Google Gemini API Key (Fallback provider)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Models (Optional overrides)
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_ASR_MODEL=openai/whisper-large-v3
HF_EMBED_MODEL=BAAI/bge-small-en-v1.5
GEMINI_MODEL=gemini-2.0-flash

# Database (Defaults to local SQLite if PostgreSQL not running)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reel

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
